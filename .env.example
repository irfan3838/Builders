# Copy to .env for local development. Never commit real values. Full table with defaults: AGENTS.md section 4.
# Only OPENAI_API_KEY is needed for the AI features; every other block is OPTIONAL (safe defaults or labelled fallbacks).
# Without OPENAI_API_KEY the app runs in no-key mode: everything works except the agent, voice and AI document reading.
# In AWS, these come from Secrets Manager / SSM Parameter Store, not this file.

# --- OpenAI (REQUIRED for AI) ---
OPENAI_API_KEY=replace-me
# Model names are config, not code. Verify availability before relying on them.
# FAST: local testing + CI (low cost). STRONG: live demo path only.
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_STRONG=
# Workflow engine (app/agent/workflows): 1 = checklist workflows on a cheap model, unknown cases escalate.
# 0 = the single Purser agent loop (app default). The live site and docker compose use 1. Compare both with: uv run python -m scripts.eval_run --arm A1,B
PURSER_WORKFLOWS=1
OPENAI_MODEL_WORKFLOW=gpt-6-luna
OPENAI_MODEL_ESCALATION=gpt-6-sol

# --- [OPTIONAL] AWS (local CLI use only; CI uses GitHub OIDC, not access keys) ---
AWS_REGION=
AWS_PROFILE=

# --- [OPTIONAL] App ---
APP_ENV=local
LOG_LEVEL=info

# --- [OPTIONAL] Voice ---
OPENAI_MODEL_VOICE=gpt-live-1.1
OPENAI_VOICE_NAME=marin
# Speaking pace 0.25-1.5 (1.0 = model default; ignored if the live API rejects it)
OPENAI_VOICE_SPEED=1.15
APP_ORIGIN=http://localhost:8000

# --- [OPTIONAL] Database (local docker compose; AWS injects from Secrets Manager) ---
DATABASE_URL=postgresql+asyncpg://munshi:munshi-local-only@localhost:5433/munshi
TEST_DATABASE_URL=postgresql+asyncpg://munshi:munshi-local-only@localhost:5433/munshi_test
SESSION_SECRET=replace-me
# Password for every seeded login (default purser-demo)
# SEED_PASSWORD=purser-demo

# --- [OPTIONAL] Email (Gmail SMTP app password). Purser only emails allow-listed addresses; set EMAIL_ALLOWED_RECIPIENTS=* to email anyone. ---
GMAIL_ADDRESS= 
GMAIL_APP_PASSWORD= 
EMAIL_ALLOWED_RECIPIENTS=
# Standard signature on every outgoing email (company defaults to the workspace name; phone/website lines optional)
SIGNATURE_COMPANY=
SIGNATURE_PHONE=
SIGNATURE_WEBSITE=
# --- [OPTIONAL] Revenue FX: ecb (live Frankfurter ECB quotes, cached; needs egress) | fixture (deterministic, offline) ---
FX_PROVIDER=ecb

# Contracts: upload limits (bills keep 10 MB / 5 pages) and our own company names, so the reviewer knows who "us" is.
CONTRACT_MAX_PAGES=15
CONTRACT_MAX_BYTES=26214400
OUR_PARTY_NAMES=Dzruptiv AI,Dzruptiv,Druptiv,Dzruptive
# CONTRACTS_MODEL=off   # patterns only (no model calls for clause scan / liabilities)

# --- [OPTIONAL] Google Calendar + Meet (one organizer account). Fill with: uv run python -m scripts.google_oauth ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
# The ONE Purser login whose real Gmail + Calendar the token above belongs to (sign in as it in scripts.google_oauth).
GOOGLE_LINKED_EMAIL=
# --- [OPTIONAL] Flight search: SerpAPI Google Flights (https://serpapi.com). Unset = a clearly labelled sample list. ---
SERPAPI_API_KEY=
# --- [OPTIONAL] LangSmith tracing (agent turns, model and tool calls). Environment: local | development | staging | production ---
LANGSMITH_TRACING=false
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=
LANGSMITH_AGENT_ID=
LANGSMITH_AGENT_ENVIRONMENT=local
CALENDAR_TIMEZONE=Asia/Kolkata
