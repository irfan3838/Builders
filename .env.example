# Copy to .env for local development. Never commit real values.
# In AWS, these come from Secrets Manager / SSM Parameter Store, not this file.

# --- OpenAI ---
OPENAI_API_KEY=replace-me
# Model names are config, not code. Verify availability before relying on them.
# FAST: local testing + CI (low cost). STRONG: live demo path only.
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_STRONG=

# --- AWS (local CLI use only; CI uses GitHub OIDC, not access keys) ---
AWS_REGION=
AWS_PROFILE=

# --- App ---
APP_ENV=local
LOG_LEVEL=info

# --- Voice ---
OPENAI_MODEL_VOICE=gpt-live-1.1
APP_ORIGIN=http://localhost:8000

# --- Database (local docker compose; AWS injects from Secrets Manager) ---
DATABASE_URL=postgresql+asyncpg://munshi:munshi-local-only@localhost:5433/munshi
TEST_DATABASE_URL=postgresql+asyncpg://munshi:munshi-local-only@localhost:5433/munshi_test
SESSION_SECRET=replace-me

# --- Email (Gmail SMTP app password). Munshi only emails allow-listed demo addresses. ---
GMAIL_ADDRESS= 
GMAIL_APP_PASSWORD= 
EMAIL_ALLOWED_RECIPIENTS=
# --- Revenue FX: ecb (live Frankfurter ECB quotes, cached; needs egress) | fixture (deterministic, offline) ---
FX_PROVIDER=ecb
