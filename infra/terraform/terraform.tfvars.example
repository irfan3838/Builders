# Copy to terraform.tfvars (gitignored). Non-secret settings only; secrets live in Secrets Manager.
app_env = {
  OPENAI_MODEL_FAST        = "gpt-5.4-mini"
  OPENAI_MODEL_STRONG      = ""
  OPENAI_MODEL_VOICE       = "gpt-live-1.1"
  GMAIL_ADDRESS            = "sender@example.com"
  EMAIL_ALLOWED_RECIPIENTS = "you@example.com"
  GOOGLE_CLIENT_ID         = "1234-abc.apps.googleusercontent.com"
}
